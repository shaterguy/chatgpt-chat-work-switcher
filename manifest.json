{
  "manifest_version": 3,
  "name": "ChatGPT Chat ↔ Work Switcher Preview",
  "version": "0.1.2",
  "description": "Experimental same-conversation Chat/Work switcher with selectable model/reasoning and reliable toolbar controls.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/profile-core.js", "src/bridge.js", "src/stream-monitor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/profile-core.js", "src/content.js", "src/switch-options.js", "src/action-toggle.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT Chat ↔ Work Switcher Preview"
  }
}
