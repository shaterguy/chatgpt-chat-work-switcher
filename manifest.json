{
  "manifest_version": 3,
  "name": "ChatGPT Chat ↔ Work Switcher Probe",
  "version": "0.0.1",
  "description": "Read-only probe that compares native Chat and Work request fingerprints without modifying ChatGPT traffic.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/profile-core.js", "src/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/profile-core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT Chat ↔ Work Switcher Probe"
  }
}
