{
  "manifest_version": 3,
  "name": "ChatGPT Request Snapshot Calibrator",
  "version": "0.2.0",
  "version_name": "0.2.0-dev1",
  "description": "Captures sanitized ChatGPT conversation-request snapshots only at prompt send time for model/reasoning calibration.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/snapshot-core.js", "src/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT Request Snapshot Calibrator",
    "default_popup": "popup.html"
  }
}
